# ============================================================
# .env.staging.example - Entorno Staging Puramente Local (Docker)
# ============================================================
APP_ENV=staging
NODE_ENV=production
PORT=3000
AUTH_SECRET=replace-with-a-random-secret-of-at-least-16-characters

# Base de datos en contenedor app-db
DB_HOST=app-db
DB_PORT=5432
DB_DATABASE=bd_proyecto_staging
DB_USERNAME=staging_user
DB_PASSWORD=replace-with-a-local-password

# Compose también usa esta variable para el contenedor PostgreSQL.
POSTGRES_PASSWORD=replace-with-a-local-password
