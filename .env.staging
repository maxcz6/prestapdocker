# Entorno Staging Local en Docker (Puramente Local)
APP_ENV=staging
NODE_ENV=production
PORT=3000
AUTH_SECRET=prestap-staging-secret-key-2026-secure

# Conexión Base de Datos Local PostgreSQL (Contenedor app-db)
DB_HOST=app-db
DB_PORT=5432
DB_DATABASE=bd_proyecto_staging
DB_USERNAME=staging_user
DB_PASSWORD=staging_password_example
POSTGRES_PASSWORD=staging_password_example
