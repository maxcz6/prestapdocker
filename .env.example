# ============================================================
# .env.example - Plantilla de variables de entorno para Docker
# Copia este archivo a .env y define tus credenciales locales.
# ============================================================

# Configuración de PostgreSQL
POSTGRES_DB=bd_proyecto_staging
POSTGRES_USER=staging_user
POSTGRES_PASSWORD=tu_contrasena_aqui

# Configuración de la aplicación
PORT=3000
HOSTNAME=0.0.0.0
NODE_ENV=production
APP_ENV=staging
DB_HOST=app-db
DB_PORT=5432
DB_DATABASE=bd_proyecto_staging
DB_USERNAME=staging_user
DB_PASSWORD=tu_contrasena_aqui

# Secreto para firma de sesiones
AUTH_SECRET=tu_secret_key_aqui
